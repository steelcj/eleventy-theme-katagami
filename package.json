{
  "name": "eleventy-theme-katagami",
  "version": "0.2.0",
  "description": "Katagami, a Plone-inspired Eleventy theme with a vintage Japanese, minimalist style, with its demo and fixture site.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Vishpala",
  "engines": {
    "node": ">=18.12"
  },
  "scripts": {
    "build": "eleventy",
    "build:production": "ELEVENTY_ENV=production eleventy",
    "start": "eleventy --serve --watch",
    "lint": "stylelint --allow-empty-input \"themes/**/*.css\" \"site/**/*.css\""
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-navigation": "^1.0.5",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.3",
    "nunjucks": "npm:@11ty/nunjucks@^3.3.0"
  },
  "devDependencies": {
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0"
  }
}
