{
  "name": "eleventy-theme-katagami",
  "version": "0.3.0",
  "description": "Katagami, a Plone-inspired Eleventy theme with a vintage Japanese, minimalist style, with its demo and fixture site.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Vishpala",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "build:production": "ELEVENTY_ENV=production eleventy",
    "start": "eleventy --serve --watch",
    "lint": "stylelint --allow-empty-input \"themes/**/*.css\" \"site/**/*.css\"",
    "check": "node scripts/check-pages.mjs",
    "fixture-images": "node scripts/make-fixture-images.mjs src/media"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.3",
    "nunjucks": "npm:@11ty/nunjucks@^3.3.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/biz-udpgothic": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@fontsource/zen-old-mincho": "^5.3.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
