{#- Site override of themes/katagami/parts/colophon.njk, proving that site/ shadows the theme. #}
{%- set colophon = katagami.siteText[lang].colophon %}
<div class="colophon" data-source="site">
  {{ colophon.html | safe }}
  <p>{{ "theme" | t(lang) }}: <bdi>{{ katagami.name }} {{ katagami.version }}</bdi></p>
</div>
