{% extends "layouts/base.njk" %}

{#- Title, lead, lead image, the Markdown body, then the page's blocks. #}
{% block content %}
      <h1>{{ title | typeset(langTag) | safe }}</h1>
      {%- if description %}
      <p class="lead">{{ description | typeset(langTag) | safe }}</p>
      {%- endif %}
      {%- include "partials/lead-image.njk" %}
      {{ content | safe }}
      {%- set blockList = blocks %}
      {%- set eagerBlock = -1 if image.src else blocks | firstImageBlock %}
      {%- set headingLevel = 2 %}
      {%- include "partials/block-list.njk" %}
{%- endblock %}
