{% extends "layouts/base.njk" %}

{#- Folder intro, lead image and blocks, then the folder's pages shown with its `view` (listing,
    summary, tabular or album) and `sort` (order, title or date). #}
{% block content %}
      <h1>{{ title }}</h1>
      {%- if description %}
      <p class="lead">{{ description }}</p>
      {%- endif %}
      {%- include "partials/lead-image.njk" %}
      {{ content | safe }}
      {%- set blockList = blocks %}
      {%- set eagerBlock = -1 if image.src else blocks | firstImageBlock %}
      {%- set headingLevel = 2 %}
      {%- include "partials/block-list.njk" %}
      {%- set items = collections.all | folderItems(page.url, sort or "order") %}
      {%- if items | length %}
      {%- set itemHeadingLevel = 3 %}
      {%- set folderView = (view or "listing") | viewPartial(page.inputPath) %}
      <section class="section-contents" aria-labelledby="section-contents-heading">
        <h2 id="section-contents-heading">{{ "inThisSection" | t(lang) }}</h2>
        {%- if folderView %}
        {% include folderView %}
        {%- else %}
        <div class="block block--unknown" role="note">{{ "unknownView" | t(lang) }}: <code dir="ltr">{{ view }}</code></div>
        {%- endif %}
      </section>
      {%- endif %}
{%- endblock %}
