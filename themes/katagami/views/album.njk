{#- Album view: a grid of cards, each with the item's lead image and title. The image is
    decorative here: the title names the link. Expects `items` and `itemHeadingLevel`. #}
<ul class="view view--album grid">
  {%- for item in items %}
  <li class="card">
    {%- if item.data.image.src %}
    {%- set img = { src: item.data.image.src, decorative: true } %}
    {%- set imgSizes = "card" %}
    {%- set imgEager = false %}
    {% include "partials/picture.njk" %}
    {%- endif %}
    <h{{ itemHeadingLevel }} class="card__title"><a href="{{ item.url }}"><bdi>{{ item.data.title | typeset(langTag) | safe }}</bdi></a></h{{ itemHeadingLevel }}>
    {%- if item.data.description %}
    <p>{{ item.data.description | typeset(langTag) | safe }}</p>
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
